70. MODELO: TRIE DE PALAVRAS (Árvore de Prefixos Estática)
-------------------------------------------------------------------------------
// Insere palavras e consulta frequência exata ou contagem de prefixos em O(|S|).
// Implementação estática (matriz fixa) para evitar alocação dinâmica (new/malloc)
// e garantir tempo de execução mínimo sem chance de colisão.
// Complexidade de Tempo: Insert O(|S|) | Query O(|S|) | Espaço: O(MAX_NOS * 26)

const int MAX_NOS = 1e6 + 5; // Soma total dos caracteres de todas as strings
const int ALFA = 26;         // Tamanho do alfabeto ('a'..'z')

int trie[MAX_NOS][ALFA];
int pass_cnt[MAX_NOS]; // Quantas palavras passam por este nó (prefixos)
int end_cnt[MAX_NOS];  // Quantas palavras terminam exatamente neste nó
int nos = 1;           // Raiz é o nó 0; próximo nó livre começa em 1

// Limpa apenas os nós utilizados (seguro para múltiplos casos de teste t > 1)
void init_trie() {
    for (int i = 0; i < nos; i++) {
        memset(trie[i], 0, sizeof(trie[i]));
        pass_cnt[i] = 0;
        end_cnt[i] = 0;
    }
    nos = 1;
}

// Insere uma palavra na Trie em O(|s|)
void insert_word(const string& s) {
    int u = 0;
    for (char ch : s) {
        int c = ch - 'a';
        if (!trie[u][c]) {
            trie[u][c] = nos++;
        }
        u = trie[u][c];
        pass_cnt[u]++;
    }
    end_cnt[u]++;
}

// Retorna quantas palavras inseridas têm 'p' como prefixo em O(|p|)
int count_prefix(const string& p) {
    int u = 0;
    for (char ch : p) {
        int c = ch - 'a';
        if (!trie[u][c]) return 0;
        u = trie[u][c];
    }
    return pass_cnt[u];
}

// Retorna quantas vezes a palavra exata 's' foi inserida em O(|s|)
int count_word(const string& s) {
    int u = 0;
    for (char ch : s) {
        int c = ch - 'a';
        if (!trie[u][c]) return 0;
        u = trie[u][c];
    }
    return end_cnt[u];
}
